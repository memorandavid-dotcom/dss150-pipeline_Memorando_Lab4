# ============================================================
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL Connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150_pipeline
POSTGRES_USER=dss150_user
POSTGRES_PASSWORD=changeme_local_only

# --- Airflow (used inside docker-compose) ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dss150_user:changeme_local_only@postgres:5432/dss150_pipeline

# --- Pipeline Settings (override config/settings.yml if needed) ---
PIPELINE_RUN_ID=
DATA_SOURCE_PATH=data/source/O_Files/ProjectData2(2025v)/ai_human_content_detection_dataset.csv

# --- Reproducibility ---
RANDOM_SEED=42
TEST_SIZE=0.2
